rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled != false;
    }

    function isOwnStaff(staffUid) {
      return signedIn() && request.auth.uid == staffUid;
    }

    match /admins/{uid} {
      allow read: if isAdmin() || isOwnStaff(uid);
      allow write: if false;
    }

    // Invitation documents are addressed by their 6-digit invitation code.
    // They contain only the information needed to verify an invitation.
    match /staffInvites/{code} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.role == 'staff'
        && request.resource.data.status == 'INVITED'
        && request.resource.data.enabled == true
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.status == 'INVITED'
          && resource.data.email == request.auth.token.email
          && request.resource.data.status == 'CLAIMED'
          && request.resource.data.claimedBy == request.auth.uid
        );

      allow delete: if isAdmin();
    }

    match /staff/{staffUid} {
      allow read: if isAdmin() || isOwnStaff(staffUid);

      allow create: if signedIn()
        && request.auth.uid == staffUid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'staff'
        && request.resource.data.enabled == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.inviteCode is string
        && exists(/databases/$(database)/documents/staffInvites/$(request.resource.data.inviteCode))
        && get(/databases/$(database)/documents/staffInvites/$(request.resource.data.inviteCode)).data.email == request.auth.token.email
        && get(/databases/$(database)/documents/staffInvites/$(request.resource.data.inviteCode)).data.status == 'INVITED'
        && get(/databases/$(database)/documents/staffInvites/$(request.resource.data.inviteCode)).data.enabled == true;

      allow update: if isAdmin()
        || (
          isOwnStaff(staffUid)
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role == 'staff'
        );

      allow delete: if isAdmin();
    }

    match /queues/{queueId} {
      allow read, write: if signedIn();
    }

    match /tickets/{ticketId} {
      allow read, write: if signedIn();
    }

    match /users/{uid} {
      allow read, write: if isOwnStaff(uid);
    }
  }
}
