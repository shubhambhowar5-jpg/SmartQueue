<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Page Title -->
        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Restaurant Queue"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <!-- Restaurant Name -->
        <TextView
            android:id="@+id/tvRestaurantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Restaurant"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- Token Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_queue_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR TOKEN"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvYourToken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="R-01"
                android:textColor="@color/primary"
                android:textSize="48sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Now Serving -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Now Serving"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvNowServing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="R-00"
            android:textColor="@color/secondary"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold" />

        <!-- People Ahead -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="People Ahead"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvPeopleAhead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_heading"
            android:textStyle="bold" />

        <!-- Estimated Wait -->
        <TextView
            android:id="@+id/tvEstimatedWait"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Estimated wait: 0 minutes"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- Queue Status -->
        <TextView
            android:id="@+id/tvQueueStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:text="Waiting"
            android:textColor="@color/queue_waiting"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <!-- Cancel Button -->
        <Button
            android:id="@+id/btnCancelQueue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="24dp"
            android:text="Cancel Queue"
            android:textAllCaps="false"
            android:textSize="@dimen/text_body" />

        <!-- Information / Error -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_small" />

    </LinearLayout>

</ScrollView>