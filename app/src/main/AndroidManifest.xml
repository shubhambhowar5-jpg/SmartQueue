<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartQueue">

        <!-- Main / Splash Activity -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.SmartQueue.Splash"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Home -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Restaurant Queue -->
        <activity
            android:name=".QueueActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- My Queue -->
        <activity
            android:name=".MyQueueActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Staff Login -->
        <activity
            android:name=".StaffLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Admin Login -->
        <activity
            android:name=".AdminLoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Admin Staff Management -->
        <activity
            android:name=".AdminStaffActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Restaurant Staff -->
        <activity
            android:name=".RestaurantStaffActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>